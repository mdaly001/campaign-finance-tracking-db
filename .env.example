# Database password for the Postgres superuser and application user
DB_PASSWORD=change-me

# Enable unredacted PII data loading (default: false).
# Only set to true if you have submitted the SOS Data Processing Request
# and placed the unredacted data in the designated volume.
UNREDACTED_ENABLED=false

# Port the MCP server listens on (inside the container: 9527)
MCP_PORT=9527

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: override the database connection string directly.
# If not set, DATABASE_URL is constructed from DB_PASSWORD and the 'db' service host.
# DATABASE_URL=postgresql://cfdb:change-me@db:5432/cfdb

# FEC integration (Phase 2)
# Free API key from https://api.data.gov/signup/ (for validation tests)
FEC_API_KEY=
# Cycles to load (comma-separated, e.g. "2024,2026")
FEC_CYCLES=2024,2026
# Cache directory for FEC bulk downloads
FEC_CACHE_DIR=/app/federal/cache
