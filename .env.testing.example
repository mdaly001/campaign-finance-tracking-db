# Testing-environment credentials (copy to .env.testing, which is gitignored).
#
#   cp .env.testing.example .env.testing
#   ./scripts/testing_env.sh up
#
# These are for the isolated `cfdbtest` stack only. They never touch Prod.

# Superuser (cfdb) password for the testing cluster.
# REQUIRED. For the copied testing cluster this must match the password the
# copied cluster's `cfdb` superuser already has (it was copied from Prod).
TEST_DB_PASSWORD=change-me

# Read-only `cfdb_reader` role password used by the testing MCP server.
# REQUIRED. For a copied cluster this must match the role's CURRENT password.
# To rotate the copied cluster to a new value:
#   docker exec cfdbtest-db psql -U cfdb -d cfdb \
#     -c "ALTER ROLE cfdb_reader PASSWORD 'your-new-value';"
# then set it here. See docs/credential-rotation.md.
CFDB_READER_PASSWORD=change-me-reader

# Host ports (loopback-only). Prod uses 9527 / unpublished db.
TEST_MCP_PORT=9528
TEST_DB_PORT=5433

# Image tag for the testing build (never `latest`, which Prod runs).
TEST_IMAGE_TAG=testing

# Logging level: DEBUG, INFO, WARNING, ERROR
TEST_LOG_LEVEL=INFO
